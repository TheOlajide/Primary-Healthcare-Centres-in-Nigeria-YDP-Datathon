table dim_medicine_inventory
	lineageTag: 8001ccd2-15bb-4443-9171-07c23f11116e
	sourceLineageTag: 181bec59-fcc2-47e2-a335-ee58de7a37f6

	measure 'Medicine Risk Score' =
			
			AVERAGEX(
			    dim_medicine_inventory,
			    SWITCH(
			        dim_medicine_inventory[stock_status],
			        "In Stock", 0.0,
			        "Low Stock", 0.4,
			        "Critical", 0.75,
			        "Stockout", 1,
			        0
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: measures
		lineageTag: a8f8a767-3aaf-45c6-b7e3-a8dfd9c20159

		annotation PBI_FormatHint = {"isCustom":true}

