	column 'PHC Risk Level-calc column' =
			
			VAR RiskScore = [Overall PHC Risk Score]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(RiskScore), BLANK(),
			        RiskScore >= 0.70, "High Risk",
			        RiskScore >= 0.40, "Medium Risk",
			        "Low Risk"
			    )
		lineageTag: ae297278-5709-4c05-87f9-421e9fbea866
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	partition fact_phc_facilities = entity
		mode: directQuery
		source
			entityName: fact_phc_facilities
			expressionSource: 'DirectQuery to AS - phc_semantic_model'

