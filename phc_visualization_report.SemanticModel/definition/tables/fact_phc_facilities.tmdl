table fact_phc_facilities
	lineageTag: 5a1c60cc-ea3f-49ce-9215-13b430c97765
	sourceLineageTag: 1c019fe5-efe4-4906-9cbc-4a051f1ed220

	measure 'total health workers' = SUM(fact_phc_facilities[total_health_workers])
		formatString: #,0
		displayFolder: _measures
		lineageTag: ea3330ac-6075-4ed6-a3c9-229c4516296b

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'total facilities' = DISTINCTCOUNT(dim_facility_services[facility_id])
		formatString: #,0
		displayFolder: _measures
		lineageTag: 11292511-3423-4d93-8e88-a22f8f09916d

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'catchment population' = SUM(fact_phc_facilities[catchment_population])
		formatString: #,0
		displayFolder: _measures
		lineageTag: 02143341-badf-4d78-a405-431f7bf365c7

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Number of Beds' = sum(fact_phc_facilities[number_of_beds])
		formatString: 0
		displayFolder: _measures
		lineageTag: 8173c8a7-8774-4eb8-a3c9-4bbba160116a

		changedProperty = DisplayFolder

	measure 'Doctor Adequacy' =
			
			MIN(
			    DIVIDE(
			        SUM(fact_phc_facilities[doctors]),
			        DISTINCTCOUNT(fact_phc_facilities[facility_id]) * 1,
			        0
			    ),
			    1
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _measures
		lineageTag: e591ddd4-1e41-4084-95b4-9269989791c7

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Nurse Adequacy' =
			
			MIN(
			    DIVIDE(
			        SUM(fact_phc_facilities[nurses]),
			        DISTINCTCOUNT(fact_phc_facilities[facility_id]) * 3,
			        0
			    ),
			    1
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _measures
		lineageTag: d1b6358a-2af4-4992-adb9-12a73b38165b

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Midwife Adequacy' =
			
			MIN(
			    DIVIDE(
			        SUM(fact_phc_facilities[midwives]),
			        DISTINCTCOUNT(fact_phc_facilities[facility_id]) * 2,
			        0
			    ),
			    1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _measures
		lineageTag: 95f7ce8a-298b-4331-9d92-c5b7d1ec244e

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'CHW Adequacy' =
			
			MIN(
			    DIVIDE(
			        SUM(fact_phc_facilities[community_health_workers]),
			        DISTINCTCOUNT(fact_phc_facilities[facility_id]) * 2,
			        0
			    ),
			    1
			)
		displayFolder: _measures
		lineageTag: d357afb9-ec39-40e8-822e-ff3b9aed1cb6

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pharmacist Adequacy' =
			
			MIN(
			    DIVIDE(
			        SUM(fact_phc_facilities[pharmacists]),
			        DISTINCTCOUNT(fact_phc_facilities[facility_id]) * 1,
			        0
			    ),
			    1
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _measures
		lineageTag: 963f9057-3aba-42d7-9ce1-34bc99415ae7

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Overall Staffing Adequacy' =
			
			AVERAGEX(
			    {
			        [Doctor Adequacy],
			        [Nurse Adequacy],
			        [Midwife Adequacy],
			        [CHW Adequacy],
			        [Pharmacist Adequacy],
			        [Laboratory Adequacy]
			    },
			    [Value]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _measures
		lineageTag: 1bb17c11-4424-4408-9ade-97f50c3d933e

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Laboratory Adequacy' =
			
			MIN(
			    DIVIDE(
			        SUM(fact_phc_facilities[laboratory_staff]),
			        DISTINCTCOUNT(fact_phc_facilities[facility_id]) * 1,
			        0
			    ),
			    1
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _measures
		lineageTag: 900128b5-b122-4984-b0fd-824e637cb771

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Staffing Risk Score' =
			1-
			[Overall Staffing Adequacy]
		formatString: 0.00000%;-0.00000%;0.00000%
		displayFolder: _measures
		lineageTag: 1a3306a6-755d-44e8-a842-80432b8075ad

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Overall PHC Risk Score' =
			
			(
			    [Medicine Risk Score] * 0.30
			)
			+
			(
			    [Vaccine Risk Score] * 0.20
			)
			+
			(
			    [Staffing Risk Score] * 0.25
			)
			+
			(
			    [Service Risk Score] * 0.25
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _measures
		lineageTag: fe6a19c7-6ae1-4c86-8b0a-60d9e3334061

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'PHC Risk Level' =
			
			SWITCH(
			    TRUE(),
			    [Overall PHC Risk Score] >= 0.7, "High Risk",
			    [Overall PHC Risk Score] >= 0.4, "Medium Risk",
			    "Low Risk"
			)
		displayFolder: _measures
		lineageTag: 24e189fe-20c2-40c4-b9b5-ab72d6761e30

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk PHCs Count' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(fact_phc_facilities[facility_id]),
			        [Overall PHC Risk Score] >= 0.7
			    )
			)
		displayFolder: _measures
		lineageTag: e0269456-e68e-41b6-b174-92259f161cd1

		changedProperty = FormatString

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Medium Risk PHCs Count' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(fact_phc_facilities[facility_id]),
			        [Overall PHC Risk Score] >= 0.4
			            && [Overall PHC Risk Score] < 0.7
			    )
			)
		formatString: #,0.00
		displayFolder: _measures
		lineageTag: e1140ccb-af58-4acb-9780-6d71ba755210

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Low Risk PHCs Count' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(fact_phc_facilities[facility_id]),
			        [Overall PHC Risk Score] < 0.4
			    )
			)
		displayFolder: _measures
		lineageTag: b8a0ab78-0970-44c2-a078-ecf8b1b4a56d

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Percentage of PHC at High Risk' =
			
			DIVIDE(
			    [High Risk PHCs Count],
			    DISTINCTCOUNT(fact_phc_facilities[facility_id]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _measures
		lineageTag: 2442c0a0-ac51-4ba4-8a6b-fc44ccb1142b

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Percentage of PHC at Medium Risk' =
			
			DIVIDE(
			    [Medium Risk PHCs Count],
			    DISTINCTCOUNT(fact_phc_facilities[facility_id]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _measures
		lineageTag: 0d2c6b8e-7639-4003-8fb0-925766d01eb5

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Facilities With Electricity' = ```
			
			CALCULATE(
			    [Total Facilities], 
			    'fact_phc_facilities'[has_electricity] = TRUE()
			)
			```
		formatString: #,0
		displayFolder: _amenities measure
		lineageTag: 7328004e-38ad-4c44-8d69-2c85147dfd8f

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Facilities With Water' = ```
			
			CALCULATE(
			    [Total Facilities], 
			    'fact_phc_facilities'[has_water] = TRUE()
			)
			
			```
		formatString: #,0
		displayFolder: _amenities measure
		lineageTag: b8fafe86-885b-4a17-be06-2c99d1cee868

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Facilities With Storage Room' = ```
			
			CALCULATE(
			    [Total Facilities], 
			    'fact_phc_facilities'[has_storage_room] = TRUE()
			)
			
			```
		formatString: #,0
		displayFolder: _amenities measure
		lineageTag: ad015315-ddca-4264-81f2-7231061d3924

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure 'Facilities Without Electricity' = ```
			
			CALCULATE(
			    [Total Facilities], 
			    'fact_phc_facilities'[has_electricity] = FALSE() || ISBLANK('fact_phc_facilities'[has_electricity])
			)
			
			```
		formatString: 0
		displayFolder: _amenities measure
		lineageTag: 35a0ae9a-1770-439c-bade-6ecc16c3ffc9

		changedProperty = DisplayFolder

		changedProperty = Name

