table dim_vaccine_inventory
	lineageTag: f5af55e4-6332-493c-ad8e-e8287daccca0
	sourceLineageTag: 5d7c84a5-aaab-4a2e-85e5-5d54477a51b8

	measure 'Vaccine Risk Score' =
			
			AVERAGEX(
			    dim_vaccine_inventory,
			    SWITCH(
			        dim_vaccine_inventory[stock_status],
			        "In Stock", 0.0,
			        "Low Stock", 0.4,
			        "Critical", 0.75,
			        "Stockout", 1,
			        0
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _measures
		lineageTag: e6acb4aa-a7fc-4fb2-8c3e-2f383e299a39

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isCustom":true}

