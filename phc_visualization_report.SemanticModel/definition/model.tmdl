model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NG
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - phc_semantic_model","Risk Categories"]

ref table dim_facility_services
ref table dim_medicine_inventory
ref table fact_phc_facilities
ref table dim_staffing
ref table dim_vaccine_inventory
ref table 'Risk Categories'

ref cultureInfo en-US

